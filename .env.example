# Override the load test target URL (default: localhost:8084/healthz via host.docker.internal)
K6_TARGET_URL=http://host.docker.internal:8084/healthz

# HOST_TESTS_PATH is set automatically by docker compose via ${PWD}/tests
# K6_EXTRA_HOSTS: comma-separated host:ip pairs forwarded to the k6 container
#   Example: K6_EXTRA_HOSTS=host.docker.internal:host-gateway
# Note: the k6 container runs UTC; pass TZ=<zone> if you need local-time labels in handleSummary
